# ============================================================================
# DeckDock Configuration
# Copy this file to config.env and fill in your values
# ============================================================================
#
# This file is bash-sourceable and Python-readable.
# Lines starting with # are comments. All values use KEY=VALUE format.
# Do not add spaces around the = sign.
#
# Quick start:
#   cp config.example.env config.env
#   nano config.env        # or run ./setup.sh for an interactive wizard
#

# ============================================================================
# Network
# ============================================================================

# Your NAS IP address (the machine with shared storage)
NAS_HOST=192.168.1.100

# Tailscale IP for remote access (optional — falls back when LAN IP unreachable)
NAS_TAILSCALE_HOST=

# SSH user for NAS (used by SSHFS mount — no sudo required)
NAS_USER=root

# Remote path on the NAS (the shared folder path)
NAS_EXPORT=/volume/shared/roms

# Your handheld device SSH connection (user@ip)
DEVICE_HOST=deck@192.168.1.150

# ============================================================================
# Paths
# ============================================================================

# Local directory for staging downloads before pushing to NAS
STAGING_DIR=$HOME/nas-staging

# Where to mount the NAS on the device (temporary mount point)
NAS_MOUNT=/tmp/nas-roms

# Subdirectory on the NAS for ROM storage
NAS_ROM_SUBDIR=roms

# Subdirectory on the NAS for save backups
NAS_SAVE_SUBDIR=saves

# ============================================================================
# Crawler
# ============================================================================

# Port for the crawler web UI
CRAWLER_PORT=7072

# Default delay between downloads (seconds)
DEFAULT_DELAY=5

# Default crawl depth
DEFAULT_DEPTH=3

# ============================================================================
# Backup
# ============================================================================

# Number of rolling save backups to keep (local and NAS)
BACKUP_KEEP=10

# ============================================================================
# Trickle Push
# ============================================================================

# Auto-push files to NAS after each download (pushes directly to NAS via SSH)
# Set to "true" to enable, "false" to batch-push later
TRICKLE_PUSH=true

# ============================================================================
# Windows Games via Proton
# ============================================================================
#
# Native Windows games (RPG Maker fan games, GameMaker projects, indie EXEs)
# can be added to the Steam library as Proton-launched shortcuts alongside
# ROM/emulator entries. Drop each game in its own subfolder under this dir
# on the device. add-roms-to-steam.py scans it and builds shortcuts that point
# at ~/Emulation/tools/launch-proton-game.sh, which sets up Proton's runtime
# environment and exec's the Windows EXE.
#
# Per-game folder convention:
#   <WINDOWS_GAMES_DIR>/<Game Name>/Game.exe          (RPG Maker XP/VX/MV/MZ)
#   <WINDOWS_GAMES_DIR>/<Game Name>/<single>.exe      (any project with one EXE)
# Folders with multiple top-level EXEs and no Game.exe are skipped.
#
# Proton version: defaults to "Proton - Experimental" (the wrapper picks the
# stock Steam install). To pin a different version, edit launch-proton-game.sh
# or set PROTON_DIR in the env at launch time.

WINDOWS_GAMES_DIR=$HOME/Games

# ============================================================================
# IGDB API (optional — for auto-classifying unknown game titles)
# ============================================================================

# Get credentials at https://dev.twitch.tv/console/apps
# If not configured, title classification uses the curated database only.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
